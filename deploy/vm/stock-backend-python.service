[Unit]
Description=Korea Stock Trading Python Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stock-auto-backend-python
EnvironmentFile=/home/ubuntu/stock-auto-backend-python/.env
ExecStart=/home/ubuntu/.local/bin/uvicorn app.main:app --host 127.0.0.1 --port 5000 --workers 1
Restart=always
RestartSec=10

# Memory limit for Oracle Free Tier (1GB VM)
MemoryMax=768M

[Install]
WantedBy=multi-user.target
