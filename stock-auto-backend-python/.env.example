# Oracle Autonomous DB (REQUIRED)
ORACLE_WALLET_PATH=/home/ubuntu/wallet
ORACLE_DSN=stockdb_high
DB_USER=ADMIN
DB_PASSWORD=your_db_password

# KIS API (optional — only for live trading)
